PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/smartbank
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Forgot-password emails (SMTP). If left unset, reset links are printed to
# the server console instead of actually emailed — handy for local dev.
# Example for Gmail: create an "App Password" at myaccount.google.com/apppasswords
# (a regular Gmail password will NOT work with SMTP).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=SmartBank <no-reply@smartbank.example.com>

# ---------------- Chatbot (Smarty) ----------------
# Provider: "gemini" | "openai" | "off"
# With "off" (or no key set) the bot still answers from the rule engine and
# the seeded FAQ knowledge base — handy for offline demos.
CHATBOT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CHATBOT_TIMEOUT_MS=15000
CHATBOT_RATE_LIMIT=20
